{
  "manifest_version": 3,
  "name": "SmallSky",
  "version": "1.0.0",
  "description": "Soft, fast student dashboard for BigSky (D2L Brightspace) at De La Salle-CSB.",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://bigsky.benilde.edu.ph/*"],
  "action": {
    "default_title": "Open SmallSky"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://bigsky.benilde.edu.ph/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "assets/*"],
      "matches": ["https://bigsky.benilde.edu.ph/*"]
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
